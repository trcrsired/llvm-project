/*
this is much more flexible than the template specialization one. since different libraries may have the their implementation of errc win32_errc for example. This allow them
to have only one category as long as the code function is a template to help constexpr and potentially reduce binary bloat.
*/

/*
pesudo throws should do
template<typename T>
requires (::std::is_class_v<T> || ::std::is_enum_v<T>)
inline constexpr void pesudo_throws(T x)
{
  using error_domain_type = get_error_domain(::std::error_domain_tag, x);
  throw ::std::error{error_domain_type::domain(), error_domain_type::code(x)};
}

*/

template<typename __Other>
requires (::std::is_class_v<__Other> || ::std::is_enum_v<__Other>)
constexpr bool operator==(::std::error const& __ec, __Other const& __other) noexcept
{
    using __other_error_domain_type = ::std::error_domain<__Other>;
    if constexpr(::std::__details::__error_domain_has_domain_alias_type<__other_error_domain_type>)
    {
        using __other_domain_alias_type = typename __other_error_domain_type::domain_alias_type;
        return __other_error_domain_type::code(__other) == __ec.code() &&
            __other_domain_alias_type::domain() == __ec.domain();
    }
    else
    {
        return __other_error_domain_type::code(__other) == __ec.code() &&
            __other_error_domain_type::domain() == __ec.domain();
    }

}

template<typename __Other>
requires (::std::is_class_v<__Other> || ::std::is_enum_v<__Other>)
constexpr bool operator==(__Other const __other, ::std::error const& __e) noexcept
{
    return __e==__other;
}

template<typename __Other>
requires requires(::std::error __e)
{
    {::std::error_domain<__Other>::from_std_error(__e)}->std::same_as<__Other>;
}
constexpr auto herbception_cast(::std::error const &__e) noexcept
{
    using __other_error_domain_type = ::std::error_domain<__Other>;
    return __other_error_domain_type::from_std_error(__e);
}

// ---------------------------------------------------------------------------
// Herbception type traits.
//
// These are thin wrappers over the compiler's `__is_herbception_*` /
// `__has_herbception_*` builtins (available under -fherbceptions), providing
// standard-library-style trait variable templates. They test the `throws`
// channel (implicit std::error); there are no `fails{E}` variants because
// fails{E} is a C-style feature restricted to free functions.
// ---------------------------------------------------------------------------
#if defined(__HERBCEPTIONS__)
template<typename __T>
inline constexpr bool is_herbception_throwsable_v = __is_herbception_throwsable(__T);

template<typename __T>
struct is_herbception_throwsable
    : ::std::bool_constant<is_herbception_throwsable_v<__T>>
{
};

template<typename __F>
inline constexpr bool is_invoke_herbceptions_fails_v =
    __is_invoke_herbceptions_fails(__F);

template<typename __F>
struct is_invoke_herbceptions_fails
    : ::std::bool_constant<is_invoke_herbceptions_fails_v<__F>>
{
};

// __invoke_herbception_fails_result<F> yields a synthetic struct with
// value_type (the success return type) and error_type (the fails{E} error
// type, void when F is not a fails function). Query it via the trailing _t
// aliases below.
template<typename __F>
using invoke_herbception_fails_result_t = __invoke_herbception_fails_result<__F>;

template<typename __F>
using invoke_herbception_fails_value_t = typename invoke_herbception_fails_result_t<__F>::value_type;

template<typename __F>
using invoke_herbception_fails_error_t = typename invoke_herbception_fails_result_t<__F>::error_type;

// Whether a type's throws-constructible/assignable/convertible operations can
// propagate a herbception error through the `throws` channel.
template<typename __T, typename... __A>
inline constexpr bool is_herbception_throws_constructible_v =
    __is_herbception_throws_constructible(__T, __A...);

template<typename __T, typename... __A>
struct is_herbception_throws_constructible
    : ::std::bool_constant<is_herbception_throws_constructible_v<__T, __A...>>
{
};

template<typename __T, typename __U>
inline constexpr bool is_herbception_throws_assignable_v =
    __is_herbception_throws_assignable(__T, __U);

template<typename __T, typename __U>
struct is_herbception_throws_assignable
    : ::std::bool_constant<is_herbception_throws_assignable_v<__T, __U>>
{
};

template<typename __T, typename __U>
